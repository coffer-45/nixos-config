{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "nixos_small",
    "padding": { "right": 4 },
    "color": {
      "1": "@PRIMARY@",
      "2": "@OUTLINE@"
    }
  },
  "display": {
    "separator": "  │  ",
    "color": {
      "keys": "@SECONDARY@",
      "title": "@PRIMARY@",
      "output": "@FOREGROUND@",
      "separator": "@OUTLINE@"
    },
    "key": { "width": 10 }
  },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    "break",
    { "type": "wm", "key": "Window" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "shell", "key": "Shell" },
    "break",
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk" },
    "break", "colors"
  ]
}
